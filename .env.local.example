# ------------------------------------------------------------------------------
# Servicimmo v2 — Variables d'environnement (app Pilote + site vitrine)
# Copier ce fichier vers `.env.local` et remplir les valeurs.
# Ne JAMAIS committer `.env.local` (cf. .gitignore).
#
# DÉPLOIEMENT COOLIFY (vitrine) : saisir ces variables dans l'onglet
# Environment Variables de l'application Coolify (PAS dans un fichier committé).
# Minimum pour faire tourner la vitrine + le questionnaire de devis :
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#   SUPABASE_SERVICE_ROLE_KEY, NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_CLIENT
# Le reste est recommandé (emails) ou propre à l'app Pilote (optionnel).
# ------------------------------------------------------------------------------

# === [REQUIS vitrine] Supabase ==============================================
# Le questionnaire de devis enregistre les demandes dans Supabase.
# URL publique du projet Supabase (format : https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé anon (publique, côté client — limitée par les policies RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role (SECRÈTE — côté serveur uniquement, bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=

# === [REQUIS vitrine] App ===================================================
# URL publique de prod (metadataBase, liens emails, redirections).
# En prod Coolify : https://<ton-domaine> (pas localhost).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Identifie le dossier lib/clients/ à utiliser. Aujourd'hui : "servicimmo".
NEXT_PUBLIC_CLIENT=servicimmo

# === [RECOMMANDÉ] Email transactionnel (Resend) =============================
# Sert à la confirmation de devis + notification interne "nouvelle demande".
# Sans ça, l'enregistrement marche mais aucun email n'est envoyé.
# https://resend.com/api-keys
RESEND_API_KEY=

# Adresse d'expédition (domaine validé dans Resend avec DKIM)
EMAIL_FROM=devis@servicimmo.fr

# Adresse interne qui reçoit les notifications "nouvelle demande"
EMAIL_INTERNAL=contact@servicimmo.fr

# Alias legacy (même valeur que EMAIL_INTERNAL) — backward compat
EMAIL_INTERNAL_NOTIFICATION=contact@servicimmo.fr

# === [OPTIONNEL — app Pilote] Stripe (paiements) ============================
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# === [OPTIONNEL — app Pilote] Pappers (enrichissement SIRET) ================
# https://www.pappers.fr/api
PAPPERS_API_KEY=

# === [OPTIONNEL] Analytics (Plausible, RGPD-friendly) =======================
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=servicimmo.fr

# === [OPTIONNEL — app Pilote] Portail client/prescripteur ===================
# Secret HS256 pour signer les magic links du portail (Sprint 4+).
# Générer via : openssl rand -base64 48
JWT_PORTAL_SECRET=

# === [OPTIONNEL] Démo / présentations client ================================
# Si les deux sont renseignées, un bouton "Connexion démo" apparaît sur /login.
# NE PAS configurer en prod publique (sauf compte démo limité + données factices).
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# === [OUTILLAGE — local seulement, PAS sur Coolify] logo.dev ================
# Utilisé uniquement par les scripts Python de récupération des logos
# (les logos sont déjà committés dans public/img/logos/). Inutile au runtime.
LOGO_DEV_API_URL=https://img.logo.dev
LOGO_DEV_PUBLIC_KEY=
LOGO_DEV_SECRET=
